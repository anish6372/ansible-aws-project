provider "aws" {
  region = var.aws_region
}

# VPC
resource "aws_vpc" "main" {
  cidr_block           = var.vpc_cidr
  enable_dns_hostnames = true
  enable_dns_support   = true

  tags = {
    Name = "multi-tier-vpc"
  }
}

# Internet Gateway
resource "aws_internet_gateway" "main" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "multi-tier-igw"
  }
}

# Public Subnet (Web + App servers)
resource "aws_subnet" "public" {
  vpc_id                  = aws_vpc.main.id
  cidr_block              = var.public_subnet_cidr
  map_public_ip_on_launch = true
  availability_zone       = "${var.aws_region}a"

  tags = {
    Name = "multi-tier-public-subnet"
  }
}

# Private Subnet (Database only — no public IP, no IGW route)
resource "aws_subnet" "private" {
  vpc_id            = aws_vpc.main.id
  cidr_block        = var.private_subnet_cidr
  availability_zone = "${var.aws_region}a"

  tags = {
    Name = "multi-tier-private-subnet"
  }
}

# Route Table for Public Subnet
resource "aws_route_table" "public" {
  vpc_id = aws_vpc.main.id

  route {
    cidr_block = "0.0.0.0/0"
    gateway_id = aws_internet_gateway.main.id
  }

  tags = {
    Name = "multi-tier-public-rt"
  }
}

resource "aws_route_table_association" "public" {
  subnet_id      = aws_subnet.public.id
  route_table_id = aws_route_table.public.id
}

# Private subnet has no IGW route — DB is unreachable from internet
resource "aws_route_table" "private" {
  vpc_id = aws_vpc.main.id

  tags = {
    Name = "multi-tier-private-rt"
  }
}

resource "aws_route_table_association" "private" {
  subnet_id      = aws_subnet.private.id
  route_table_id = aws_route_table.private.id
}

# -------------------------------------------------------------------
# Security Groups — one per tier, least-privilege
# -------------------------------------------------------------------

# Bastion / jump host SG — SSH restricted to your operator IP
resource "aws_security_group" "bastion_sg" {
  name        = "bastion_sg"
  description = "SSH access from operator IP only"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "SSH from operator"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.operator_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "bastion_sg" }
}

# Web server SG — HTTP/HTTPS public, SSH only from operator
resource "aws_security_group" "web_sg" {
  name        = "web_sg"
  description = "Nginx web server"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "HTTP"
    from_port   = 80
    to_port     = 80
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "HTTPS"
    from_port   = 443
    to_port     = 443
    protocol    = "tcp"
    cidr_blocks = ["0.0.0.0/0"]
  }

  ingress {
    description = "SSH from operator"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.operator_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "web_sg" }
}

# App server SG — Node.js only from web SG, SSH from operator
resource "aws_security_group" "app_sg" {
  name        = "app_sg"
  description = "Node.js backend API"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "Node.js API from web server only"
    from_port       = 3000
    to_port         = 3000
    protocol        = "tcp"
    security_groups = [aws_security_group.web_sg.id]
  }

  ingress {
    description = "SSH from operator"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.operator_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "app_sg" }
}

# DB SG — PostgreSQL only from app SG, SSH from operator (via VPC)
resource "aws_security_group" "db_sg" {
  name        = "db_sg"
  description = "PostgreSQL database - private subnet"
  vpc_id      = aws_vpc.main.id

  ingress {
    description     = "PostgreSQL from app server only"
    from_port       = 5432
    to_port         = 5432
    protocol        = "tcp"
    security_groups = [aws_security_group.app_sg.id]
  }

  ingress {
    description = "SSH from operator (for Ansible)"
    from_port   = 22
    to_port     = 22
    protocol    = "tcp"
    cidr_blocks = [var.operator_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "db_sg" }
}

# Monitoring SG — Node Exporter restricted to VPC only (not public)
resource "aws_security_group" "monitoring_sg" {
  name        = "monitoring_sg"
  description = "Prometheus Node Exporter - VPC internal only"
  vpc_id      = aws_vpc.main.id

  ingress {
    description = "Node Exporter metrics - VPC only"
    from_port   = 9100
    to_port     = 9100
    protocol    = "tcp"
    cidr_blocks = [var.vpc_cidr]
  }

  egress {
    from_port   = 0
    to_port     = 0
    protocol    = "-1"
    cidr_blocks = ["0.0.0.0/0"]
  }

  tags = { Name = "monitoring_sg" }
}

# -------------------------------------------------------------------
# EC2 Instances
# -------------------------------------------------------------------

# Web Server — public subnet, public IP
resource "aws_instance" "web" {
  ami                    = var.ami_id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.web_sg.id, aws_security_group.monitoring_sg.id]
  key_name               = var.key_name

  tags = {
    Name = "WebServer"
    Role = "webserver"
  }
}

# App Server — public subnet (needs internet for npm install), no public HTTP
resource "aws_instance" "app" {
  ami                    = var.ami_id
  instance_type          = var.instance_type
  subnet_id              = aws_subnet.public.id
  vpc_security_group_ids = [aws_security_group.app_sg.id, aws_security_group.monitoring_sg.id]
  key_name               = var.key_name

  tags = {
    Name = "AppServer"
    Role = "backend"
  }
}

# Database Server — Public subnet for Ansible access (production would use bastion)
resource "aws_instance" "db" {
  ami                    = var.ami_id
  instance_type          = var.db_instance_type
  subnet_id              = aws_subnet.public.id  # public for Ansible SSH access
  vpc_security_group_ids = [aws_security_group.db_sg.id, aws_security_group.monitoring_sg.id]
  key_name               = var.key_name

  tags = {
    Name = "DatabaseServer"
    Role = "database"
  }
}
